<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androidexample">

    <!-- 🌐 Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Craftsy"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 🛰 WebSocket Background Service -->
        <service
            android:name=".WebSocketNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

        <!-- 🚀 Login (Launcher) -->
        <activity
            android:name=".Login"
            android:exported="true"
            android:theme="@style/Theme.Craftsy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PatternActivity"
            android:exported="true" />
        <!-- 👤 User Management -->
        <activity android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".DeleteActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".UserProfile"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".OutsideUserProfile"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- 📰 Feed -->
        <activity android:name=".FeedActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".FeedCRUDActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".FeedDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- 🔍 Search -->
        <activity android:name=".SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- 🔔 Notifications -->
        <activity android:name=".NotificationCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- 🎥 Tutorials -->
        <activity android:name=".TutorialFeedActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".TutorialDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity android:name=".TutorialUploadActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <!--  Messaging -->
        <activity android:name=".MessagingHomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Craftsy" />
        <activity android:name=".DirectMessagingActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <activity android:name=".NewChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <activity android:name=".SelectUserActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
    </application>
</manifest>