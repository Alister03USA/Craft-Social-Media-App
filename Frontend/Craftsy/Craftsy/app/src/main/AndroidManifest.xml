<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androidexample">

    <!-- Internet permission for Volley requests -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Craftsy"
        android:networkSecurityConfig="@xml/network_security_config"
        >

        <!-- Login activity is the launcher -->
        <activity
            android:name=".Login"
            android:exported="false"
            android:theme="@style/Theme.Craftsy">

        </activity>

        <!-- Add your UserProfile activity -->
        <activity
            android:name=".UserProfile"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />


        <!-- Delete page -->
        <activity
            android:name=".DeleteActivity"
            android:exported="false" />

        <!-- Signup page (temporary launcher for your demo) -->
        <activity
            android:name=".SignupActivity"
            android:exported="false">

        </activity>

                <!-- Notification Center Activity (currently the launcher) -->
                <activity
                    android:name=".NotificationCenterActivity"
                    android:exported="true"
                    android:theme="@style/Theme.Craftsy">

                </activity>

                <!-- User Profile Activity -->
                <activity
                    android:name=".OutsideUserProfile"
                    android:exported="true"
                    android:theme="@style/Theme.Craftsy" >
                    <intent-filter>
                        <action android:name="android.intent.action.MAIN" />
                        <category android:name="android.intent.category.LAUNCHER" />
                    </intent-filter>



                </activity>
            </application>

        </manifest>


