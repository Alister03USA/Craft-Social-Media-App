<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="8dp">

    <LinearLayout android:orientation="vertical" android:layout_weight="1"
        android:layout_width="0dp" android:layout_height="wrap_content">
        <TextView android:id="@+id/memberUsername" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/memberEmail" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#666"/>
    </LinearLayout>

    <Button android:id="@+id/memberRemoveBtn" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Remove" android:visibility="gone"/>

</LinearLayout>
