<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/blue_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Bar -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/backToFeedButton"
                style="@style/CraftsyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back to Feed"
                android:backgroundTint="@color/blue_secondary"
                android:textSize="16sp" />

            <TextView
                android:text="Create Pattern"
                android:textColor="@color/text_black"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_marginStart="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Image Upload -->
        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:background="@drawable/craftsy_image_placeholder"
            android:contentDescription="Pattern Image" />

        <Button
            android:id="@+id/selectImageButton"
            style="@style/CraftsyButton"
            android:text="Select Image"
            android:backgroundTint="@color/button_blue" />

        <!-- Text Inputs -->
        <EditText
            android:id="@+id/patternTitleInput"
            android:hint="Pattern Title"
            android:textColor="@color/text_black"
            android:background="@drawable/craftsy_card_bg"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/patternDescInput"
            android:hint="Pattern Description"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:minHeight="120dp"
            android:textColor="@color/text_black"
            android:background="@drawable/craftsy_card_bg"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <!-- Pattern Type Input -->
        <EditText
            android:id="@+id/patternTypeInput"
            android:hint="Pattern Type (e.g., Knitting)"
            android:textColor="@color/text_black"
            android:background="@drawable/craftsy_card_bg"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Difficulty Spinner -->
        <Spinner
            android:id="@+id/difficultySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/craftsy_card_bg"/>


        <!-- Submit -->
        <Button
            android:id="@+id/uploadPatternButton"
            style="@style/CraftsyButton"
            android:text="Post Pattern"
            android:backgroundTint="@color/button_blue"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
