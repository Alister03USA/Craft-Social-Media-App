<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Tabs for Leaderboard | Tiers -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutPoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_primary"
        app:tabTextColor="@color/text_white"
        app:tabSelectedTextColor="@color/text_white"
        app:tabIndicatorColor="@color/text_white"
        app:tabIndicatorHeight="3dp"
        />

    <!-- ViewPager2 that switches between fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPoints"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>