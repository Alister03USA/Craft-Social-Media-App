<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <!-- Top row: Left = Tier Points, Right = Edit + Notifs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- LEFT SIDE: Points + Tier -->
                <LinearLayout
                    android:id="@+id/pointsTierContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="start"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/tierBadge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/badge_beginner" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/pointsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Points: 0"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tierText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tier: BEGINNER"
                            android:textSize="14sp" />

                        <ProgressBar
                            android:id="@+id/tierProgress"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="150dp"
                            android:layout_height="10dp"
                            android:max="100"
                            android:progress="0" />

                        <Button
                            android:id="@+id/btnPointsCenter"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Points Center"
                            android:textSize="12sp"
                            android:background="@android:color/holo_blue_light"
                            android:textColor="@android:color/white" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Spacer between left and right -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <!-- RIGHT SIDE: Edit + Notifs -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <Button
                        android:id="@+id/editProfile"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:background="#4586EF"
                        android:text="Edit User"
                        android:textSize="10sp"
                        android:textColor="#ffffff" />

                    <Button
                        android:id="@+id/notifButton"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FF9800"
                        android:text="Notifs"
                        android:textSize="10sp"
                        android:textColor="#ffffff" />
                </LinearLayout>
            </LinearLayout>


            <!-- Profile image -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/profile"
                android:scaleType="centerCrop"
                android:contentDescription="Profile picture" />

            <TextView
                android:id="@+id/displayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="usernamejohndoe"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/CraftSpecialties"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I like all crafts!"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is my bio..."
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Followers / Following -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/followersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123 Followers"
                    android:textStyle="bold"
                    android:layout_marginEnd="24dp" />

                <TextView
                    android:id="@+id/followingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200 Following"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Posts grid -->
            <GridLayout
                android:id="@+id/postsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:useDefaultMargins="true"
                android:alignmentMode="alignMargins" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>