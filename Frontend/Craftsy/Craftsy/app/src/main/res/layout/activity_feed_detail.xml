<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/blue_background">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBackFeedDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/dark_text"
            android:layout_marginBottom="12dp" />

        <!-- Card container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/rounded_white_card"
            android:clipToOutline="true">

            <!-- Image -->
            <ImageView
                android:id="@+id/imageProject"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="centerCrop"
                android:background="@color/gray"
                android:src="@drawable/ic_post_placeholder"
                android:layout_marginBottom="12dp" />

            <!-- Project Title -->
            <TextView
                android:id="@+id/textProjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Project Name"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/black" />

            <!-- Username -->
            <TextView
                android:id="@+id/textUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="14sp"
                android:textColor="@color/medium_text"
                android:layout_marginBottom="8dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/textProjectDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Project description"
                android:textSize="16sp"
                android:textColor="@color/dark_text_strong"
                android:layout_marginBottom="12dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray"
                android:layout_marginBottom="12dp" />

            <!-- Detail text -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/textProjectType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type: test"
                    android:textColor="@color/medium_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textSupplies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supplies: test"
                    android:textColor="@color/medium_text"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textVisibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visibility: Public"
                    android:textColor="@color/medium_text"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date: 2025-11-30"
                    android:textColor="@color/medium_text"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp" />
            </LinearLayout>
            <!-- Like row -->
            <LinearLayout
                android:id="@+id/likeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnLikeFeed"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_heart"
                    android:contentDescription="Like" />

                <TextView
                    android:id="@+id/textFeedLikes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 likes"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <Button
                android:id="@+id/btnSaveFeedProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save to Board"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/button_blue" />
        </LinearLayout>

        <!-- Comments header -->
        <TextView
            android:id="@+id/commentsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comments"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="6dp" />

        <!-- Comments container -->
        <LinearLayout
            android:id="@+id/commentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <!-- Add comment card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:elevation="2dp"
            android:background="@drawable/rounded_white_card">

            <EditText
                android:id="@+id/commentInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Add a comment..."
                android:padding="10dp"
                android:background="@drawable/rounded_edittext_bg" />

            <Button
                android:id="@+id/postCommentButton"
                android:layout_width="90dp"
                android:layout_height="44dp"
                android:text="Post"
                android:backgroundTint="@color/button_blue" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>