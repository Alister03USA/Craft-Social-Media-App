<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- (1) Header -->
    <RelativeLayout
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <!-- Direct Chat Profile Image -->
        <ImageView
            android:id="@+id/topProfileImage"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="9dp"
            android:layout_toEndOf="@id/btnBack"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:src="@drawable/profile" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_toEndOf="@id/btnBack"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- (2) Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- (3) Reply Preview -->
    <LinearLayout
        android:id="@+id/replyContainer"
        android:visibility="gone"
        android:padding="8dp"
        android:background="@drawable/bg_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_gray"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvReplyPreview"
            android:text="Replying to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- (4) Scroll to Latest Floating Button -->
    <ImageButton
        android:id="@+id/btnScrollLatest"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="6dp"
        android:src="@drawable/ic_down"
        android:contentDescription="Latest" />

    <!-- (5) Input Row -->
    <LinearLayout
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnAttach"
            android:src="@drawable/ic_attach"
            android:background="@android:color/transparent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Attach" />

        <AutoCompleteTextView
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:hint="Message..."
            android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
            android:maxLines="4"
            android:minLines="1" />

        <ImageButton
            android:id="@+id/btnSend"
            android:src="@drawable/ic_send"
            android:background="@android:color/transparent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>