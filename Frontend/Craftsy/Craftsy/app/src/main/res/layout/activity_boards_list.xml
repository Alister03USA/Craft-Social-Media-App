<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/craftsy_background">

    <!-- Title -->
    <TextView
        android:id="@+id/txtBoardsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saved Boards"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_margin="16dp"
        android:textColor="@color/dark_text" />

    <!-- Recycler of boards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBoards"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtBoardsTitle"
        android:padding="12dp" />

    <!-- Create board button -->
    <ImageButton
        android:id="@+id/btnCreateBoard"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_add"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_button"
        android:contentDescription="Create Board" />

</RelativeLayout>