<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header with back button inline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
            android:id="@+id/adminBackBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Panel"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- Add member -->
        <EditText
            android:id="@+id/adminAddMemberInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username to add" />

        <Button
            android:id="@+id/adminAddMemberBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add member"
            android:layout_marginTop="8dp" />

        <!-- Members list -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Members:"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/adminMembersRv"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

        <!-- Transfer admin -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transfer admin"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/adminTransferInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="New admin username" />

        <Button
            android:id="@+id/adminTransferBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transfer Admin"
            android:layout_marginTop="8dp" />

        <!-- Update group -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update group info"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/adminUpdateName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Group name" />

        <EditText
            android:id="@+id/adminUpdateDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description" />

        <EditText
            android:id="@+id/adminUpdateCraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Craft" />

        <Button
            android:id="@+id/adminUpdateGroupBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Group"
            android:layout_marginTop="8dp" />

        <!-- Delete group -->
        <Button
            android:id="@+id/adminDeleteGroupBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Group"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/holo_red_dark" />

    </LinearLayout>
</ScrollView>
