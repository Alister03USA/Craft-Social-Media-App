<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/craftsy_background">

    <!-- Single allowed child inside ScrollView -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBackBoardDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/dark_text"
            android:layout_marginBottom="12dp" />

        <!-- Board name -->
        <TextView
            android:id="@+id/txtBoardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Board Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text" />

        <!-- Description box -->
        <EditText
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Board description"
            android:layout_marginTop="10dp" />

        <!-- Save description -->
        <Button
            android:id="@+id/btnSaveDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Description"
            android:layout_marginTop="8dp" />

        <!-- Delete board -->
        <Button
            android:id="@+id/btnDeleteBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Board"
            android:layout_marginTop="6dp"
            android:textColor="@color/red" />

        <!-- Patterns -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patterns"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPatterns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Projects -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Projects"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Tutorials -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tutorials"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTutorials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</ScrollView>