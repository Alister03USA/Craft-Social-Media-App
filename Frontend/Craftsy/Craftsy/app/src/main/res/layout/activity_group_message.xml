<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- ========================================================= -->
    <!-- Header bar -->
    <!-- ========================================================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:padding="12dp">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back" />

        <!-- Group picture -->
        <ImageView
            android:id="@+id/groupIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="9dp"
            android:src="@drawable/ic_groups"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/group_icon" />

        <!-- Group chat title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/groupIcon"
            android:layout_marginStart="12dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text" />

        <!-- MENU BUTTON (visible for group chats only) -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/menu"
            app:tint="@color/dark_text"
            android:layout_centerVertical="true" />

    </RelativeLayout>

    <!-- ========================================================= -->
    <!-- Message List -->
    <!-- ========================================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- ========================================================= -->
    <!-- Reply Preview -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/replyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@drawable/bg_reply">

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel_reply"
            app:tint="@color/text_gray" />

        <TextView
            android:id="@+id/tvReplyPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/replying_to"
            android:textColor="@color/dark_text"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- Scroll to Latest Button -->
    <!-- ========================================================= -->
    <ImageButton
        android:id="@+id/btnScrollLatest"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal|bottom"
        android:src="@drawable/ic_down"
        android:contentDescription="@string/scroll_latest"
        android:background="@android:color/transparent"
        app:tint="@color/dark_text"
        android:layout_marginBottom="6dp" />

    <!-- ========================================================= -->
    <!-- Input Row -->
    <!-- ========================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_attach"
            android:background="@android:color/transparent"
            android:contentDescription="@string/attach"
            app:tint="@color/dark_text" />

        <AutoCompleteTextView
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/message_hint"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="1"
            android:textColor="@color/dark_text"
            android:textColorHint="@color/text_gray" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_send"
            android:background="@android:color/transparent"
            android:contentDescription="@string/send"
            app:tint="@color/button_blue" />

    </LinearLayout>

</LinearLayout>