<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar with Back Button -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/backButton"
            android:text="← Back"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Pattern Details"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Pattern Image -->
            <ImageView
                android:id="@+id/detailImage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:scaleType="centerCrop"
                android:layout_marginBottom="16dp"
                android:background="#CCCCCC"/>

            <!-- Pattern Name -->
            <TextView
                android:id="@+id/detailName"
                android:text="Pattern Name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Pattern Type / Difficulty -->
            <TextView
                android:id="@+id/detailTypeDifficulty"
                android:text="Type • Difficulty"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Rating Section -->
            <LinearLayout
                android:id="@+id/ratingLayout"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RatingBar
                    android:id="@+id/detailRatingBar"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:rating="3.1"
                    android:isIndicator="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/averageRatingText"
                    android:text="3.1 avg"
                    android:textSize="18sp"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/detailDescription"
                android:text="This pattern is great for..."
                android:textSize="18sp"
                android:layout_marginBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Reviews Header -->
            <TextView
                android:text="Reviews"
                android:textStyle="bold"
                android:textSize="22sp"
                android:layout_marginBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Reviews List -->
            <ListView
                android:id="@+id/reviewsList"
                android:divider="#CCCCCC"
                android:dividerHeight="1dp"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <!-- Add Review Button -->
            <Button
                android:id="@+id/addReviewButton"
                android:text="Add Review"
                android:textSize="18sp"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
