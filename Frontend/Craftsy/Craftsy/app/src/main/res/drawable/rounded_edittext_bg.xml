<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Light background for comment box -->
    <solid android:color="@color/blue_background" />

    <!-- Subtle gray border -->
    <stroke
        android:width="1dp"
        android:color="@color/text_gray" />

    <!-- Inner padding -->
    <padding
        android:left="8dp"
        android:top="6dp"
        android:right="8dp"
        android:bottom="6dp" />
</shape>