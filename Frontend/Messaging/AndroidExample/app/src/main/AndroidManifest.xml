<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androidexample">

    <!-- Internet & network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Craftsy"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- User selection screen is launcher -->
        <activity
            android:name=".SelectUserActivity"
            android:exported="true"
            android:theme="@style/Theme.Craftsy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Messaging Home -->
        <activity
            android:name=".MessagingHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- New Chat creation screen -->
        <activity
            android:name=".NewChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- Direct message screen -->
        <activity
            android:name=".DirectMessagingActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />
    </application>
</manifest>