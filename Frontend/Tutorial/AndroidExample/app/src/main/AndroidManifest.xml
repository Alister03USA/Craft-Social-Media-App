<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.androidexample">

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Access to local storage for file uploads -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Craftsy"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- MAIN PAGE: Tutorial Feed (Launcher Activity) -->
        <activity
            android:name=".TutorialFeedActivity"
            android:exported="true"
            android:theme="@style/Theme.Craftsy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Tutorial Upload Page -->
        <activity
            android:name=".TutorialUploadActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

        <!-- Tutorial Detail Page -->
        <activity
            android:name=".TutorialDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Craftsy" />

    </application>
</manifest>