<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_background">

    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/tutorialTitle"
            android:hint="Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_input_bg"
            android:padding="10dp"
            android:textColor="@color/text_black"
            android:textColorHint="@color/text_gray"/>

        <EditText
            android:id="@+id/tutorialDesc"
            android:hint="Description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_input_bg"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_black"
            android:textColorHint="@color/text_gray"/>

        <EditText
            android:id="@+id/tutorialCategory"
            android:hint="Category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_input_bg"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_black"
            android:textColorHint="@color/text_gray"/>

        <!-- Upload by file -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload by video file"
            android:textStyle="bold"
            android:textColor="@color/text_black"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/selectFileBtn"
                android:text="Choose File"
                android:backgroundTint="@color/blue_secondary"
                android:textColor="@color/text_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/uploadFileBtn"
                android:text="Upload File"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/button_blue"
                android:textColor="@color/text_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Upload by URL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload by URL"
            android:textStyle="bold"
            android:textColor="@color/text_black"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/tutorialUrl"
            android:hint="https://…"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/search_input_bg"
            android:padding="10dp"
            android:textColor="@color/text_black"
            android:textColorHint="@color/text_gray"
            android:layout_marginTop="6dp"/>

        <Button
            android:id="@+id/uploadUrlBtn"
            android:text="Upload URL"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/button_blue"
            android:textColor="@color/text_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp" />

    </LinearLayout>
</ScrollView>