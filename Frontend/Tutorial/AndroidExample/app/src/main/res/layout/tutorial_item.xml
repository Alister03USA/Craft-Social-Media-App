<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tutorial_card_background"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_margin="8dp">

    <ImageView
        android:id="@+id/tutorialThumbnail"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_post_placeholder"
        android:contentDescription="Tutorial Thumbnail" />

    <TextView
        android:id="@+id/tutorialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tutorial Title"
        android:textColor="@color/text_black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tutorialCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tutorialDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tutorial Description"
        android:textColor="@color/text_black"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>