<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@color/blue_background">

    <TextView
        android:id="@+id/detailTitle"
        android:text="Tutorial"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/text_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <VideoView
        android:id="@+id/detailVideo"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@id/detailTitle"
        android:layout_marginTop="8dp"/>

    <ImageView
        android:id="@+id/detailImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@id/detailTitle"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_post_placeholder"/>

    <TextView
        android:id="@+id/detailDescription"
        android:layout_below="@id/detailVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_black"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/detailCategory"
        android:layout_below="@id/detailDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blue_primary"
        android:layout_marginTop="6dp"/>

    <LinearLayout
        android:id="@+id/detailButtons"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/detailCategory"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/backToFeedBtn"
            android:text="Back"
            android:backgroundTint="@color/blue_secondary"
            android:textColor="@color/text_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/deleteTutorialBtn"
            android:text="Delete"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/button_blue"
            android:textColor="@color/text_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>