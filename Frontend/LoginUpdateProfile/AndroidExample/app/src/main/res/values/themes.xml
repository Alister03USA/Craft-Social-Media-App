<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AndroidExample" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Override Material3 color scheme -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/blue_on_primary</item>

        <item name="colorSecondary">@color/blue_secondary</item>
        <item name="colorOnSecondary">@color/blue_on_secondary</item>

        <item name="android:colorBackground">@color/blue_background</item>
        <item name="colorOnBackground">@color/blue_on_background</item>
    </style>

    <style name="Theme.AndroidExample" parent="Base.Theme.AndroidExample" />

    <style name="Theme.AndroidExample.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AndroidExample.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AndroidExample.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
