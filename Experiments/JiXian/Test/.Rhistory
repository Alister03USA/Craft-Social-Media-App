m <- 200
alpha <- 0.05
expected_errors <- m * alpha
expected_errors
FWER <- 1 - (1 - alpha)^m
round(FWER, 4)
bonf_cutoff <- alpha / m
bonf_cutoff
set.seed(2025)
n <- 1000; p <- 200
# predictors
X <- matrix(rnorm(n*p), nrow=n, ncol=p)
colnames(X) <- paste0("X", 1:p)
# true model with 5 nonzero coefficients
true_idx <- c(3, 17, 29, 101, 150)
beta <- rep(0, p)
beta[true_idx] <- c(1.5, -1.2, 0.8, 1.0, -0.9)
# response
y <- X %*% beta + rnorm(n)
# fit full model
fit <- lm(y ~ ., data = data.frame(y, X))
pvals <- summary(fit)$coefficients[-1, 4]
sig_plain <- sum(pvals <= alpha)
sig_bonf  <- sum(pvals <= bonf_cutoff)
c(Unadjusted = sig_plain, Bonferroni = sig_bonf)
set.seed(42)
n <- 100
x1 <- runif(n)
x2 <- 0.8*x1 + rnorm(n, 0, 0.1)
beta0 <- 3; beta1 <- 2; beta2 <- 4; sigma <- 2
y <- beta0 + beta1*x1 + beta2*x2 + rnorm(n, 0, sigma)
cor(x1, x2)
prostate <- read.table("prostate.data", header = TRUE)
prostate_full <- subset(prostate, select = -train)
best_fit <- regsubsets(lpsa ~ ., data = prostate_full, nvmax = ncol(prostate_full)-1)
